#!/bin/bash -l
# Modified for Aurora XPU compatibility by the FRAME-IDP Aurora port; see aurora/README.md.
# Generate on one Aurora XPU tile. Submit with e.g.:
# qsub -A FRAME-IDP -q debug -v GENIE3_CONFIG=/path/to/experiment.yaml genie3_generate.pbs
# Override GENIE3_NUM_DEVICES only after the one-device smoke job passes.
#PBS -N genie3-generate-xpu
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=1:00:00
#PBS -l filesystems=home:flare

set -euo pipefail

repo="${GENIE3_REPO:-${PBS_O_WORKDIR:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}}"
source "${repo}/aurora/activate_genie3_aurora.sh"

config=${GENIE3_CONFIG:-${repo}/examples/unconditional/experiment.yaml}
devices=${GENIE3_NUM_DEVICES:-1}

cd "${repo}"
genie3 generate --config "${config}" --num-devices "${devices}" --verbose
