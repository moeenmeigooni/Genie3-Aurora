#!/bin/bash -l
# Modified for Aurora XPU compatibility by the FRAME-IDP Aurora port; see aurora/README.md.
# Run the one-XPU full evaluation on an existing generation output directory.
# Submit: qsub -A FRAME-IDP -q debug -v GENIE3_CONFIG=/path/to/config genie3_evaluate.pbs
#PBS -N genie3-evaluate-xpu
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=1:00:00
#PBS -l filesystems=home:flare

set -euo pipefail

repo="${GENIE3_REPO:-${PBS_O_WORKDIR:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)}}"
source "${repo}/aurora/activate_genie3_aurora.sh"

config=${GENIE3_CONFIG:-${repo}/aurora/xpu_full_pipeline_validation.yaml}
devices=${GENIE3_NUM_DEVICES:-1}

cd "${repo}"
genie3 evaluate --config "${config}" --num-devices "${devices}" --verbose
genie3 evaluate --config "${config}" --num-devices "${devices}" --verbose --reduce
